# Адрес API. На реальном телефоне localhost не сработает —
# подставьте IP компьютера в локальной сети, например http://192.168.1.5:4100
EXPO_PUBLIC_API_URL=http://localhost:4100/api
EXPO_PUBLIC_ASSETS_URL=http://localhost:4100

# Фотореалистичный 3D Google: карту рисует страница портала /embed/map3d,
# приложение показывает её в WebView. Ключ живёт на стороне портала, поэтому
# его можно ограничить по HTTP-referrer.
EXPO_PUBLIC_EMBED_URL=http://localhost:3100/embed/map3d
# 0 — остаться на бесплатной векторной карте (оффлайн-сборка, кончилась квота).
EXPO_PUBLIC_GOOGLE_3D=1
