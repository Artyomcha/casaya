# Адрес API. На реальном телефоне localhost не сработает —
# подставьте IP компьютера в локальной сети, например http://192.168.1.5:4100
EXPO_PUBLIC_API_URL=http://localhost:4100/api
EXPO_PUBLIC_ASSETS_URL=http://localhost:4100

# Фотореалистичный 3D Google через нативный Maps 3D SDK.
# Ключ отдельный от портального: натив ограничивается по bundle ID приложения,
# а не по HTTP-referrer. Нужны Maps 3D SDK for iOS и Maps3D API for Android.
# Пусто — карта остаётся на бесплатной векторной подложке.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
