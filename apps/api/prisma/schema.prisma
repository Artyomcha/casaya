generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyKind {
  FLAT
  STUDIO
  PENTHOUSE
  HOUSE
  VILLA
  TOWNHOUSE
  COMMERCIAL
}

enum DealType {
  SALE
  RENT
}

enum LeadKind {
  MORTGAGE
  SERVICE
  AGENCY
  LISTING_CONTACT
}

/// Стадии воронки в CRM. Порядок — порядок движения сделки.
enum LeadStatus {
  NEW
  CONTACTED
  VIEWING
  NEGOTIATION
  WON
  LOST
}

enum ServiceScope {
  HOME
  FULL
}

/// Формат XML-выгрузки CRM агентства.
enum FeedFormat {
  INMOVILLA
  WITEI
  MOBILIA
  KYERO
  RESALES
  CASAYA
}

enum FeedStatus {
  PENDING
  ACTIVE
  PAUSED
  ERROR
}

enum FeedRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ListingSource {
  MANUAL
  FEED
}

/// Уровень платного продвижения объявления.
enum PromotionTier {
  /// Обычная выдача.
  NONE
  /// Subida — разовый подъём наверх.
  BUMP
  /// Destacado — выделение цветом и вес в ранжировании.
  FEATURED
  /// Top района — закреплённые места в своём районе.
  TOP_AREA
}

enum PromotionStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Где показалось объявление — нужно, чтобы считать CTR по местам.
enum Placement {
  SEARCH
  MAP
  LISTING_CARD
  RECOMMENDATION
  HOME
}

enum ListingStatus {
  DRAFT
  MODERATION
  PUBLISHED
  ARCHIVED
}

/// Агентство-партнёр, поставляет инвентарь через XML-фид CRM.
model Agency {
  id         String    @id @default(cuid())
  name       String    @unique
  initials   String
  brandColor String
  /// Логотип агентства. Пусто — показываем инициалы на фирменном цвете.
  logoUrl    String?
  crm        String?
  feedUrl    String?
  verified   Boolean   @default(true)
  replyTime  Int       @default(12)
  planKey    String?
  plan       Plan?     @relation(fields: [planKey], references: [key])
  listings   Listing[]
  feeds      AgencyFeed[]
  members    AgencyMember[]
  leads      Lead[]
  contactEmail String?
  contactPhone String?
  freeUntil  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Подключённая XML-выгрузка CRM. Один фид = один источник инвентаря.
model AgencyFeed {
  id           String     @id @default(cuid())
  agencyId     String
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  url          String
  format       FeedFormat @default(CASAYA)
  status       FeedStatus @default(PENDING)
  /// Как часто опрашивать источник, минут.
  intervalMin  Int        @default(60)
  lastRunAt    DateTime?
  lastOkAt     DateTime?
  lastError    String?
  listingCount Int        @default(0)
  runs         FeedRun[]
  listings     Listing[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([agencyId, url])
  @@index([status, lastRunAt])
}

/// Журнал одной синхронизации фида.
model FeedRun {
  id         String        @id @default(cuid())
  feedId     String
  feed       AgencyFeed    @relation(fields: [feedId], references: [id], onDelete: Cascade)
  status     FeedRunStatus @default(RUNNING)
  parsed     Int           @default(0)
  created    Int           @default(0)
  updated    Int           @default(0)
  archived   Int           @default(0)
  skipped    Int           @default(0)
  error      String?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([feedId, startedAt])
}

/// Сотрудник агентства в кабинете Casaya Pro.
model AgencyMember {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("manager")
  createdAt DateTime @default(now())

  @@unique([agencyId, userId])
}

/// Реальный объект недвижимости.
///
/// Одну и ту же квартиру обычно продают 5–10 агентств сразу — на классических
/// порталах это пять одинаковых карточек в выдаче. Мы схлопываем их в один
/// Property, а предложения агентств держим как отдельные Listing.
/// Оплаченное продвижение объявления на срок.
model Promotion {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tier       PromotionTier
  status     PromotionStatus @default(SCHEDULED)
  /// Район, в котором куплен топ. Пусто — продвижение по всей выдаче.
  area       String?
  startsAt   DateTime        @default(now())
  endsAt     DateTime
  /// Сколько заплачено, в центах — деньги целыми числами.
  priceCents Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([listingId, status])
  @@index([status, endsAt])
}

/// Показы и клики по дням — из них считается CTR в кабинете.
model ListingStat {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  placement   Placement
  impressions Int       @default(0)
  clicks      Int       @default(0)
  leads       Int       @default(0)

  @@unique([listingId, day, placement])
  @@index([listingId, day])
}

model Property {
  id           String       @id @default(cuid())
  slug         String       @unique
  /// Referencia catastral — официальный идентификатор объекта в Испании.
  /// Если он есть в обоих фидах, дубль определяется без всякой эвристики.
  cadastralRef String?      @unique
  address      String
  city         String       @default("Alicante")
  lat          Float?
  lng          Float?
  kind         PropertyKind
  area         Int
  bedrooms     Int
  bathrooms    Int
  /// Этаж различает соседние одинаковые квартиры в одном доме.
  floor        Int?
  seaView      Boolean      @default(false)
  yearBuilt    Int?
  /// Грубый ключ для отбора кандидатов: город, тип, площадь, спальни, сетка координат.
  matchKey     String
  listings     Listing[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([matchKey])
  @@index([lat, lng])
}

model Listing {
  id            String       @id
  slug          String       @unique
  title         String
  address       String
  city          String       @default("Аликанте")
  kind          PropertyKind
  deal          DealType     @default(SALE)
  price         Int
  area          Int
  bedrooms      Int
  bathrooms     Int
  seaView       Boolean      @default(false)
  seaDistance   String?
  yearBuilt     Int?
  verified      Boolean      @default(true)
  verifiedAt    DateTime?
  badge         String?
  description   String       @db.Text
  features      String[]
  coverImage    String
  gallery       String[]
  /// Координаты для карты. Из фида берутся как есть, у ручных объявлений
  /// проставляются геокодером при модерации.
  lat           Float?
  lng           Float?
  videoTour     Boolean      @default(true)
  source        ListingSource @default(MANUAL)
  status        ListingStatus @default(PUBLISHED)
  /// Идентификатор объекта в CRM агентства — ключ дедупликации при импорте.
  externalId    String?
  /// Отпечаток payload из фида: если не изменился, объект не переписываем.
  externalHash  String?
  lastSeenAt    DateTime?
  feedId        String?
  feed          AgencyFeed?  @relation(fields: [feedId], references: [id], onDelete: SetNull)
  /// Объект, к которому относится это предложение. Несколько Listing на один
  /// Property — это и есть «дубль», только показанный честно.
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id])
  /// Частное объявление: собственник вместо агентства.
  ownerId       String?
  owner         User?        @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  favorites     Favorite[]
  leads         Lead[]
  promotions    Promotion[]
  stats         ListingStat[]
  publishedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([agencyId, externalId])
  @@index([propertyId, price])
  @@index([kind, deal, price])
  @@index([seaView])
  @@index([lat, lng])
  @@index([status, publishedAt])
}

/// Новостройка (obra nueva).
model Project {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  address      String
  priceFrom    Int
  deliveryLabel String
  deliveryYear String
  developer    String
  units        String
  image        String
  specs        Json
  listings     Listing[]
  createdAt    DateTime  @default(now())
}

model City {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  listingsCount Int
  pricePerM2  Int
  image       String
  sort        Int    @default(0)
}

/// Банк-партнёр Casaya Hipotecas.
model Bank {
  id           String @id @default(cuid())
  name         String @unique
  initial      String
  brandColor   String
  rate         String
  ltv          String
  term         String
  decisionTime String
  sort         Int    @default(0)
}

/// Тариф Casaya Pro.
model Plan {
  key       String   @id
  name      String
  price     String
  per       String
  tag       String?
  items     String[]
  cta       String
  sort      Int      @default(0)
  agencies  Agency[]
}

/// Сервисный слой сделки (Legal, Escrow, Hipotecas, Move...).
model ServiceOffer {
  id          String       @id @default(cuid())
  slug        String       @unique
  brand       String
  title       String
  description String
  price       String?
  bg          String
  fg          String
  icon        String       @db.Text
  scope       ServiceScope @default(FULL)
  sort        Int          @default(0)
}

model User {
  id        String     @id @default(cuid())
  phone     String?    @unique
  email     String?    @unique
  name      String?
  /// Аватар частного продавца.
  avatarUrl String?
  locale    String     @default("ru")
  favorites Favorite[]
  leads     Lead[]
  agencies  AgencyMember[]
  assignedLeads Lead[]  @relation("LeadAssignee")
  leadNotes LeadNote[]
  /// Собственник-частник ведёт свои объявления без агентства.
  ownedListings Listing[] @relation("ListingOwner")
  createdAt DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Lead {
  id        String     @id @default(cuid())
  kind      LeadKind
  status    LeadStatus @default(NEW)
  /// Агентство или собственник, которому адресован отклик.
  agencyId  String?
  agency    Agency?    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  /// Кто ведёт отклик внутри агентства.
  assigneeId String?
  assignee   User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes      LeadNote[]
  /// Бюджет и сроки покупателя — их видно агентству вместо анонимного запроса.
  budget     Int?
  needsMortgage Boolean?
  /// Когда с покупателем связались и когда запланирован следующий шаг.
  contactedAt DateTime?
  nextStepAt  DateTime?
  name      String?
  email     String?
  phone     String?
  country   String?
  message   String?
  payload   Json?
  listingId String?
  listing   Listing?   @relation(fields: [listingId], references: [id])
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@index([kind, status])
  @@index([agencyId, status])
}

/// Запись в истории отклика — вся переписка менеджера внутри CRM.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Сохранённый расчёт автоматической оценки.
model Valuation {
  id        String       @id @default(cuid())
  address   String
  kind      PropertyKind
  area      Int
  bedrooms  Int
  estimate  Int
  low       Int
  high      Int
  pricePerM2 Int
  rent      Int
  createdAt DateTime     @default(now())
}
