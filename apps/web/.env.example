# Адрес NestJS API
NEXT_PUBLIC_API_URL=http://localhost:4100/api
# Серверные запросы внутри docker-сети могут идти на другой хост
API_URL=http://localhost:4100/api

# Ключ Google Maps Platform с включённым Map Tiles API.
# Задан — карта показывает фотореалистичный 3D-город (Photorealistic 3D Tiles),
# тарифицируется по корневому запросу тайлсета (сессия до 3 часов).
# Пустой — карта работает на бесплатной векторной подложке с объёмными домами.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
